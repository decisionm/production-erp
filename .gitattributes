# The knowledge system is byte-exact: LF only, everywhere it validates.
docs/factory/** text eol=lf
# ...except photographic evidence: images are binary, and the manifest's
# sha256 pins are over the raw bytes — text normalization would corrupt both.
docs/factory/sources/**/*.jpg binary
docs/factory/sources/**/*.jpeg binary
docs/factory/sources/**/*.png binary
scripts/factory-knowledge/** text eol=lf
.claude/skills/** text eol=lf
AGENTS.md text eol=lf
CLAUDE.md text eol=lf

# The Tally agent's installer is built on a WINDOWS runner, and
# tests/purchaseOrder.test.js compares generated XML against a golden fixture
# BYTE FOR BYTE. The builder emits LF; a Windows checkout without this rule
# converts the fixture to CRLF, so the comparison fails on a file nobody
# edited. That is not hypothetical — it is why every agent build has failed
# since Phase 6 (c4b5b78) added the fixture, and therefore why 0.3.6 through
# 0.3.9 were never published and the factory is still running 0.3.5.
# Same reasoning as the knowledge system above: byte-exact means LF only.
tally-sync-agent/tests/** text eol=lf
