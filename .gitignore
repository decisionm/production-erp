# Local Claude Code session/tool state — not project content.
# Claude Code: skills are version-controlled (shared workflows); local
# settings and session state stay untracked.
.claude/*
!.claude/skills/

# VSCode Local History extension — not project content.
.history/

# Deployment build artifacts — contain the production APP_KEY, never commit.
deployment_files/
~$*
__pycache__/
*.pyc

# macOS Finder metadata — not project content. Only backend/.gitignore carried
# a rule, which is how docs/.DS_Store reached main in 6ba89b4 (untracked
# 16-Aug). The pattern is unanchored so it matches at any depth.
.DS_Store

# Migration working files (19-Aug-2026 move to decisionm/actech).
# These carry LIVE credentials and factory data — untracked is not enough,
# one `git add -A` would put a live DB password in GitHub history forever.
/.env
/env
/*.sql
/storage.zip
/MIGRATION-HANDOFF.md
