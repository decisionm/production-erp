<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- The suite boots ~1,300 Laravel apps in one process and peaks at
             ~120 MB real (~129 MB allocated) — right at PHP's default 128M,
             where a run dies with "Allowed memory size exhausted" in whichever
             test happens to boot next (seen twice at 1,318 tests, 17-Aug-2026).
             Raised so the whole suite is one deterministic run; the growth
             itself is the ordinary per-app-boot retention, not a leak in any
             one module. -->
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <!-- Feature flags pinned so the suite is deterministic regardless of
             a developer's local .env. Tests that exercise the flag ON set it
             with config() themselves. -->
        <env name="PROD_TRACEABILITY" value="false"/>
        <env name="PROD_READINESS_ENFORCED" value="false"/>
        <env name="TALLY_SYNC_PURCHASE_ORDERS_ENABLED" value="false"/>
        <!-- Synthetic, FC-06-safe (no real Tally company name) — lets any test that
             flips purchase_orders_enabled on exercise the staged payload without also
             having to configure the allowed-company gate itself. -->
        <env name="TALLY_SYNC_PURCHASE_ORDERS_ALLOWED_COMPANY" value="Testing Tally Company Alpha"/>
        <!-- Pinned ON: most of the existing TallySync suite fires GoodsReceiptNoteReceived
             directly and asserts a Receipt Note voucher is staged from it — the pre-existing,
             tested contract. The application default (config/tally-sync.php, no env set) is
             OFF, per the owner's confirmation that the factory does not use Tally Receipt
             Notes; ReceiptNoteFeatureFlagTest exercises that OFF behaviour explicitly. -->
        <env name="TALLY_SYNC_RECEIPT_NOTES_ENABLED" value="true"/>
        <!-- Same rule as the PO allowed-company pin above: synthetic, FC-06-safe,
             so the suite's staged Receipt Notes pass the fail-closed company gate
             without every fixture configuring it. -->
        <env name="TALLY_SYNC_RECEIPT_NOTES_ALLOWED_COMPANY" value="Testing Tally Company Alpha"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
