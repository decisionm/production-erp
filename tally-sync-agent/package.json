{
  "name": "tally-sync-agent",
  "productName": "Tally Sync Agent",
  "version": "0.2.0",
  "description": "Local Windows tray agent \u2014 bridges the ERP's cloud Tally sync queue to a local Tally installation's XML-HTTP gateway. See ../docs/archive/TALLY-SYNC-MASTER-PLAN.md \u00a711 (archived).",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.js",
    "package:win": "npm run build && electron-builder --win",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "electron-log": "^5.2.4",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.9",
    "fast-xml-parser": "^5.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "electron": "^43.1.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3"
  },
  "build": {
    "appId": "in.amrtech.erpdemo.tallysyncagent",
    "productName": "Tally Sync Agent",
    "directories": {
      "output": "release"
    },
    "artifactName": "tally-sync-agent-setup-${version}.exe",
    "publish": [
      {
        "provider": "generic",
        "url": "https://erpdemo.amrtech.in/storage/agent/"
      }
    ],
    "files": [
      "dist/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false
    }
  }
}
